# Template for ~/.config/bugloop/cluster.env — the operator's shell environment
# for a LIVE campaign (docs/RUN.md level C). Copy it, fill in your own values,
# and `set -a; source ~/.config/bugloop/cluster.env; set +a` before `chia up`.
# No secret belongs in this file: the model key lives in gemini.env.example's
# copy, the GitHub token in a 0600 file of its own.

# The head node's hostname, as cluster_single.yaml's head_* commands see it.
export CHIA_HEAD=your-hostname

# The artefact root, bind-mounted into the workers. Must exist and be writable.
export BUGLOOP_ARTEFACTS=$HOME/bugloop-artefacts

# The assertions-on image tag built from upstream/dockerfiles/ChiaCirctAssertDockerfile.
export BUGLOOP_IMAGE_TAG=000000000000

# The venv activate script `ray start --head` ran from. cluster_single.yaml
# sources it in every head_* command and cannot default it.
export BUGLOOP_HEAD_ENV=$HOME/path/to/CHIA_Hackathon_2k26/.venv/bin/activate

# Only read by the GCP cluster YAML; leave as-is for the single-machine run.
export BUGLOOP_GCP_HEAD_IP=unset

# `chia up` mounts the agent socket. Start one if absent:
#   eval $(ssh-agent -a /run/user/$(id -u)/bugloop-ssh-agent.sock)
export SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-/run/user/1000/bugloop-ssh-agent.sock}
