     def _get_node_id(self) -> str:
-        try:
-            return ray.get_runtime_context().get_node_id()
-        except Exception:
+        """This node's Ray id, or ``"unknown"`` — bounded, and never for ever.
+
+        ``ray.get_runtime_context()`` retries the GCS five seconds at a time
+        FOR EVER when ``/tmp/ray/ray_current_cluster`` names a cluster that is
+        down, and an ``except`` cannot catch a call that never returns. All four
+        callers are on error paths — a blocked prompt, a blocked response,
+        ``MAX_TOKENS``, and every translated ``APIError`` — so a 429 met on a
+        machine with a stale file hung the caller instead of retrying (measured:
+        twelve minutes, then killed, with the turn's token counts lost with the
+        process). The call cannot be cancelled, so it runs on a daemon thread
+        the answer is given up on after ``NODE_ID_TIMEOUT_SECONDS``.
+        """
+        import threading
+
+        # MEASURED, and the reason the thread below is not enough on its own:
+        # with no Ray in this process, ``get_runtime_context()`` blocks for
+        # SIXTY seconds and then Ray's own client calls QuickExit - "Failed to
+        # connect to GCS within 60 seconds ... The program will terminate." - so
+        # the background thread would take the whole process down ten seconds
+        # after this method had already answered. A process with no Ray has no
+        # node id to report, so it does not ask.
+        if not ray.is_initialized():
             return "unknown"
 
+        answer = {}
+
+        def _read():
+            try:
+                answer["node_id"] = ray.get_runtime_context().get_node_id()
+            except Exception:
+                pass
+
+        worker = threading.Thread(target=_read, name="vertex-node-id",
+                                  daemon=True)
+        worker.start()
+        worker.join(NODE_ID_TIMEOUT_SECONDS)
+        return answer.get("node_id") or "unknown"
+
+    # ------------------------------------------------------------------
+    # The per-turn money ceiling
+    # ------------------------------------------------------------------
+
+    def _turn_prices(self) -> tuple:
+        """``(input, output)`` USD per million tokens for this model."""
+        for prefix, prices in TURN_BUDGET_PRICES.items():
+            if (self.model or "").startswith(prefix):
+                return prices
+        return TURN_BUDGET_DEFAULT_PRICES
+
+    def _priced_usage_usd(self, meta: dict) -> float:
+        """What the loop has spent so far this turn, at this model's prices.
+
+        Thinking tokens are billed as output and tool-use prompt tokens as
+        input; both are separate scalars from ``candidates_token_count`` and
+        ``prompt_token_count``.
+        """
+        price_in, price_out = self._turn_prices()
+        tokens_in = meta.get("input_tokens", 0) + meta.get("tool_use_prompt_tokens", 0)
+        tokens_out = meta.get("output_tokens", 0) + meta.get("thinking_tokens", 0)
+        return tokens_in / 1e6 * price_in + tokens_out / 1e6 * price_out
+
+    def _conversation_chars(self, contents) -> int:
+        """The characters the NEXT ``generate_content`` call will re-send.
+
+        The system instruction plus every part of every content: text, a
+        function call's arguments and a function response's body. It is the
+        conversation's size and not the original prompt's, which is the whole
+        point — the prompt is a constant and the conversation is what grows.
+        """
+        import json as _json
+
+        total = len(self.system_message or "")
+        for content in contents or []:
+            for part in getattr(content, "parts", None) or []:
+                total += len(getattr(part, "text", None) or "")
+                call = getattr(part, "function_call", None)
+                if call is not None:
+                    total += len(_json.dumps(dict(getattr(call, "args", None) or {}),
+                                             default=str))
+                response = getattr(part, "function_response", None)
+                if response is not None:
+                    total += len(_json.dumps(
+                        dict(getattr(response, "response", None) or {}), default=str))
+        return total
+
+    def _check_turn_budget(self, meta: dict, contents) -> None:
+        """Refuse the next call when it would take this turn past its ceiling.
+
+        Raises:
+            TurnBudgetExceeded, before anything is sent. ``_last_metadata``
+            still reports what the turn spent getting here, the ``finally`` in
+            ``_run_generate`` publishing it on every path.
+        """
+        if not self.turn_budget_usd:
+            return
+        price_in, price_out = self._turn_prices()
+        spent = self._priced_usage_usd(meta)
+        estimate = (self._conversation_chars(contents)
+                    / TURN_BUDGET_CHARS_PER_TOKEN / 1e6 * price_in
+                    + self.max_tokens / 1e6 * price_out)
+        if spent + estimate > self.turn_budget_usd:
+            raise TurnBudgetExceeded(
+                node_id=self._get_node_id(),
+                budget_usd=float(self.turn_budget_usd),
+                spent_usd=spent, estimate_usd=estimate,
+                raw_message=(
+                    f"refusing call {meta.get('num_turns', 0) + 1} of this turn: "
+                    f"USD {spent:.6f} already spent plus an estimated "
+                    f"{estimate:.6f} would pass turn_budget_usd "
+                    f"{float(self.turn_budget_usd):.6f}"))
+
