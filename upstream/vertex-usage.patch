+class TurnBudgetExceeded(VertexError):
+    """The tool loop would have spent past ``turn_budget_usd`` on its NEXT call.
+
+    Raised BEFORE that ``generate_content`` is sent, so the money it names was
+    never spent. A turn with tools re-sends the whole conversation on every
+    iteration, so its input cost grows quadratically in the number of tool
+    calls: measured, one turn made 37 calls and cost 64x what its caller had
+    authorised for it. ``turn_budget_usd`` is the caller's ceiling for ONE turn
+    and this is the loop refusing to cross it. Never retried: the next attempt
+    would re-send the same conversation and cost the same.
+    """
+
+    def __init__(self, node_id: str, budget_usd: float = 0.0,
+                 spent_usd: float = 0.0, estimate_usd: float = 0.0,
+                 raw_message: str = ""):
+        self.budget_usd = budget_usd
+        self.spent_usd = spent_usd
+        self.estimate_usd = estimate_usd
+        super().__init__(node_id, "turn_budget_exceeded", None, raw_message)
+
+    def __reduce__(self):
+        return (self.__class__, (self.node_id, self.budget_usd, self.spent_usd,
+                                 self.estimate_usd, self.raw_message))
+
+
+#: Characters per token, for the per-turn budget estimate ONLY. An estimate,
+#: used where an OVER-estimate is the safe direction: a conversation that
+#: tokenises to fewer characters per token than this is allowed to make a call
+#: that costs more than the estimate said, by whatever the ratio is wrong by.
+#: 2.0 is a measurement rounded down - one real turn billed 619,603 input
+#: tokens for 1,509,080 characters, 2.436 characters per token.
+TURN_BUDGET_CHARS_PER_TOKEN = 2.0
+
+#: USD per MILLION tokens, ``(input, output)``, by model-id prefix, for the
+#: per-turn budget estimate ONLY: it prices nothing the caller is billed for
+#: and no caller should read it. Only entries verified against Google's own
+#: published pricing are listed; every other model takes
+#: ``TURN_BUDGET_DEFAULT_PRICES``, which is deliberately expensive, because an
+#: unknown model priced too low is a ceiling that binds too late.
+TURN_BUDGET_PRICES = {
+    "gemini-3.8-flash": (0.75, 3.75),      # verified 2026-09-15
+}
+TURN_BUDGET_DEFAULT_PRICES = (10.0, 40.0)
+
+#: Seconds ``_get_node_id`` waits for Ray before answering "unknown".
+NODE_ID_TIMEOUT_SECONDS = 10.0
+
+#: The backoff ``_one_call`` waits out a 429 with: the first wait in seconds,
+#: doubled per attempt, never past the cap, each wait randomised by +/- the
+#: jitter so concurrent stage nodes do not re-send together. A refused call is
+#: billed nothing, so waiting costs the turn wall clock only - and the arm
+#: window already bounds that. MEASURED, pilot 7: express-mode quota refused a
+#: campaign's first call outright and one 429 ended the whole turn.
+RATE_LIMIT_BACKOFF_SECONDS = 20.0
+RATE_LIMIT_BACKOFF_CAP_SECONDS = 300.0
+RATE_LIMIT_BACKOFF_JITTER = 0.2
+
+#: A ``Retry-After`` count of seconds, or a protobuf duration ("17s", "1.5s").
+_RETRY_DELAY_PATTERN = re.compile(r"^\s*([0-9]+(?:\.[0-9]+)?)s?\s*$")
+
+
+def _retry_after_seconds(exc) -> Optional[float]:
+    """The wait a 429 itself names, or None when it names none.
+
+    Two places carry it and the header wins: ``Retry-After`` on the response,
+    and a ``google.rpc.RetryInfo`` ``retryDelay`` among the error body's
+    details. None leaves the caller on its own backoff.
+    """
+    asked = []
+    headers = getattr(getattr(exc, "response", None), "headers", None)
+    if headers is not None:
+        try:
+            asked.append(headers.get("Retry-After"))
+        except Exception:
+            pass
+    details = getattr(exc, "details", None)
+    error = details.get("error") if isinstance(details, dict) else None
+    inner = error.get("details") if isinstance(error, dict) else None
+    for item in inner if isinstance(inner, list) else []:
+        if isinstance(item, dict) and item.get("retryDelay") is not None:
+            asked.append(item["retryDelay"])
+    for value in asked:
+        matched = _RETRY_DELAY_PATTERN.match(str(value or ""))
+        if matched:
+            return float(matched.group(1))
+    return None
+
